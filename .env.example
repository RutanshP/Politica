# Required for Congress.gov sync jobs
POLITICA_DEFAULT_CONGRESS=119
POLITICA_CONGRESS_API_BASE_URL=https://api.congress.gov/v3
POLITICA_CONGRESS_API_KEY=replace-with-your-congress-api-key
POLITICA_HOUSE_VOTE_BASE_URL=https://clerk.house.gov/evs
POLITICA_SENATE_VOTE_BASE_URL=https://www.senate.gov/legislative/LIS/roll_call_votes
POLITICA_CONGRESS_FETCH_TIMEOUT_MS=20000
POLITICA_FEDERAL_VOTE_FETCH_TIMEOUT_MS=15000
POLITICA_LEGISLATION_PAGE_SIZE=50
POLITICA_LEGISLATION_MAX_BILLS=40
POLITICA_LEGISLATION_MAX_COMMITTEES=20
POLITICA_FEDERAL_VOTE_BATCH_SIZE=5
POLITICA_FEDERAL_VOTE_MAX_CONSECUTIVE_MISSES=6
POLITICA_FEDERAL_VOTE_MAX_PER_SESSION=120

# Optional legacy alias if you prefer the shorter key name
CONGRESS_API_KEY=

# Optional for campaign finance nodes in the funding graph
POLITICA_FEC_API_BASE_URL=https://api.open.fec.gov/v1
POLITICA_FEC_API_KEY=replace-with-your-fec-api-key

# Optional legacy alias if you prefer the shorter key name
FEC_API_KEY=

# Governors (/api/internal/sync/executive). State legislature coverage is switched off and its
# data deleted -- see README "Scope: Congress only". POLITICA_OPENSTATES_STATE_CODES and the
# legislature syncs only matter if you set POLITICA_ENABLE_STATE_SYNC=1.
POLITICA_OPENSTATES_API_BASE_URL=https://v3.openstates.org
POLITICA_OPENSTATES_API_KEY=replace-with-your-openstates-api-key
POLITICA_OPENSTATES_STATE_CODES=ca,ny,tx,fl,il,pa,oh,ga,mi,nc

# Optional for connected news ingestion through NewsAPI.ai / Event Registry
POLITICA_NEWS_API_BASE_URL=https://eventregistry.org/api/v1
POLITICA_NEWS_API_KEY=replace-with-your-newsapi-ai-key

# Required for DB-backed politicians, bills, committees, issues, and news
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
POLITICA_SUPABASE_SCHEMA=public

# Required to protect the sync endpoint that Supabase cron/Edge Functions will call
POLITICA_SYNC_SECRET=replace-with-a-long-random-sync-secret

# Optional for lobbying disclosure ingestion (LDA REST API).
# lda.gov and lda.senate.gov serve the same data; lda.gov is the destination of the migration.
# Free key from https://lda.gov/api/auth/login/ -- unauthenticated requests are heavily throttled.
POLITICA_LDA_API_BASE_URL=https://lda.gov/api/v1
POLITICA_LDA_API_KEY=replace-with-your-lda-api-key

# Optional, for scoring disclosed stock trades against the market.
#
# The disclosures themselves need no key: the House Clerk and Senate EFD systems are open. This is
# only for the daily closes that per-trade performance is computed from, and without it the trading
# pages still show every trade, holding and yearly volume -- just no "vs market" figures.
#
# A keyed provider is required because every keyless source fails from a server: Yahoo's chart
# endpoint answers curl but returns 429 to Node on every request regardless of headers or rate,
# Stooq gates its CSV behind a JavaScript challenge, and stockanalysis.com serves only ~6 months
# of history while these disclosures start in 2012.
#
# twelvedata (default, 800 requests/day free) or alphavantage (25/day free).
POLITICA_STOCK_PRICE_PROVIDER=twelvedata
POLITICA_STOCK_PRICE_API_KEY=replace-with-your-price-api-key
