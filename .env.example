# Required for the current live bills, politicians, committees, issues, and dashboard data
POLITICA_DEFAULT_CONGRESS=119
POLITICA_CONGRESS_API_BASE_URL=https://api.congress.gov/v3
POLITICA_CONGRESS_API_KEY=replace-with-your-congress-api-key

# Optional legacy alias if you prefer the shorter key name
CONGRESS_API_KEY=

# Optional for campaign finance nodes in the funding graph
POLITICA_FEC_API_BASE_URL=https://api.open.fec.gov/v1
POLITICA_FEC_API_KEY=replace-with-your-fec-api-key

# Optional legacy alias if you prefer the shorter key name
FEC_API_KEY=
